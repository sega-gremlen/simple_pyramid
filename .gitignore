# Игнорировать всё в корне и во всех подпапках
/*

# Разрешить сам .gitignore (чтобы он попал в репозиторий)
!/.gitignore

# ==============================================
# СЮДА ВПИШИТЕ СВОИ ФАЙЛЫ (пути относительно корня)
# ==============================================

# Файлы в корне для загрузки
!/gui.py
!/main.py
!/pinger.py
!/backend.py
!/.gitignore
!/req.txt
!/pyinstaller_command.txt
!/config.py
!/favicon.ico
# Разрешаем папку utils (чтобы Git вообще в неё заходил)
!/utils/

# Затем разрешаем конкретные файлы
!/utils/pinger.py
!/utils/xlsx_exporter.py